# ===========================================================================
# SAT-AI environment template
#
# Copy to .env and fill in.  `.env` is gitignored and must NEVER be committed.
#   Windows PowerShell:  Copy-Item .env.example .env
#   bash:                cp .env.example .env
#
# Where these are read:
#
#   satai/config.py       everything used by the library and the ML plane. This
#                         is the only place those are read; credentials there
#                         are SecretStr and do not appear in repr or logs.
#   backend/api/*.py      the SUPABASE_*, CORS_ALLOW_ORIGINS, GEMINI_* and
#                         API_RATE_LIMIT_PER_MINUTE values. The serving plane
#                         reads os.environ directly and deliberately: importing
#                         pydantic-settings would pull the whole config layer
#                         into a serverless bundle with a size budget. That is
#                         a real exception to the ADR-003 rule, not an
#                         oversight, and it is why the list above says so.
#   next.config / browser NEXT_PUBLIC_* only, at build time.
#
# See ADR-003.
#
# Phase 1 needs NOTHING here to be filled in -- the scaffold runs with defaults.
# Credentials become necessary in Phase 2 (data acquisition).
# ===========================================================================

# --- Application ---------------------------------------------------------
SATAI_ENV=development              # development | staging | production
SATAI_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
SATAI_LOG_FORMAT=console           # console (human) | json (production)
SATAI_DATA_DIR=./data
SATAI_MODELS_DIR=./models

# --- LLM provider: Google Gemini -----------------------------------------
# BACKEND ONLY. This key must never appear behind a NEXT_PUBLIC_ prefix, in
# frontend JavaScript, in a health response, or in a log line. Anything with
# that prefix is compiled into the browser bundle and is public.
#
# Get a key: https://aistudio.google.com/apikey
#
# GEMINI_MODEL is configurable on purpose. The default below is a current
# production model, but identifiers are retired on Google's schedule -- run
# `python scripts/check_env.py` to list what your key can actually reach.
LLM_PROVIDER=google
GEMINI_API_KEY=                    # NEVER commit a real value
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=1200
GEMINI_TIMEOUT_S=45
GEMINI_MAX_TOOL_ROUNDS=3           # tool-calling rounds before the model must answer
GEMINI_FALLBACK_MODEL=gemini-3.8-flash  # tried once if GEMINI_MODEL is retired or out of quota

# --- Google Earth Engine (primary data plane, ADR-002) -------------------
# Free for noncommercial use. Register a Cloud project at
#   https://code.earthengine.google.com  ->  then `earthengine authenticate`
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT_EMAIL=         # optional: only for unattended batch jobs
GEE_SERVICE_ACCOUNT_KEY_PATH=      # path to JSON key; keep OUTSIDE the repo

# --- Copernicus Data Space Ecosystem (secondary / verification plane) -----
# Free registration: https://dataspace.copernicus.eu
# Free tier as of 2026-09: 10,000 Sentinel Hub PU/month, 12 TB/30d download.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDSE_USERNAME=
CDSE_PASSWORD=

# --- NASA Earthdata (GPM IMERG precipitation) ----------------------------
# Free registration: https://urs.earthdata.nasa.gov
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# --- NASA FIRMS (active fire detections) ---------------------------------
# Free MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# --- Copernicus Climate Data Store (ERA5 / ERA5-Land) --------------------
# Free registration: https://cds.climate.copernicus.eu
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=

# --- Database (batch plane: direct Postgres over the wire) ---------------
# Local dev is served by docker-compose (PostGIS). Production: Neon/Supabase.
# Used by the ML plane. The serving plane does NOT use this -- see below.
DATABASE_URL=postgresql+psycopg://satai:satai@localhost:5432/satai
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5

# --- Supabase / PostgREST (serving plane) --------------------------------
# The deployed FastAPI reads the catalogue over PostgREST rather than holding
# a Postgres connection, because a pooled connection per serverless invocation
# is a liability. Unset, it falls back to the public demo catalogue and logs
# that it has done so.
SUPABASE_URL=
SUPABASE_ANON_KEY=                 # publishable key; read-only under RLS
SUPABASE_TABLE_PREFIX=satai_       # the public read-view prefix (migration 002)
# Service-role key. Write credential, NEVER in the repository and never behind
# a NEXT_PUBLIC_ prefix. Its only use is appending to satai.chat_turns, the C1
# audit log; with it unset the audit log is disabled and /health says so.
SUPABASE_SERVICE_KEY=

# --- Object storage (COGs, tiles, model artifacts) -----------------------
# S3-compatible: Cloudflare R2, Supabase Storage, MinIO, or AWS S3.
STORAGE_BACKEND=local              # local | s3
STORAGE_LOCAL_ROOT=./data/processed
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- API server ----------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
# Comma-separated. Must include your Vercel production + preview domains.
CORS_ALLOW_ORIGINS=http://localhost:3000
API_RATE_LIMIT_PER_MINUTE=60

# --- Frontend (Next.js reads only NEXT_PUBLIC_* at build time) -----------
# WARNING: anything prefixed NEXT_PUBLIC_ is shipped to the browser.
# Never put a secret behind that prefix.
NEXT_PUBLIC_API_URL=http://localhost:8000
# The dashboard reads the catalogue straight from PostgREST: it is public,
# read-only data and a second hop through the API would add latency for
# nothing. Publishable key only -- the service-role key above must never
# appear here, which is the entire reason these are separate variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
